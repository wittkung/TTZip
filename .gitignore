# ==============================================================================
# TTZip Repository Hygiene & Git Ignore Rules
# High-Performance Swift 6 + C11 Native Archiving Engine
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. macOS System & Finder Metadata
# ------------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# ------------------------------------------------------------------------------
# 2. SwiftPM & Xcode Build Outputs
# ------------------------------------------------------------------------------
.build/
.build_*/
build/
build_*/
dist/
build_dist/
build_app/
DerivedData/
xcuserdata/
*.xcworkspace/
.swiftpm/
!TTZip.xcodeproj/project.pbxproj
!TTZip.xcodeproj/project.xcworkspace/contents.xcworkspacedata

# ------------------------------------------------------------------------------
# 3. C / C++ Compilation & Intermediate Objects
# ------------------------------------------------------------------------------
*.o
*.obj
*.dSYM/
*.so
*.dylib
*.dll
*.out
*.app
*.ipa
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ------------------------------------------------------------------------------
# 4. Vendor Upstream Clones & Git Worktrees
# (Isolates development upstream clones while preserving pre-built static libs)
# ------------------------------------------------------------------------------
Vendor/*-upstream/
Vendor/turbobench/
Vendor/worktrees/
.worktrees/

# ------------------------------------------------------------------------------
# 5. Static Libraries & Binary Targets
# (Globally ignore .a except tracked Vendor libraries required by Package.swift)
# ------------------------------------------------------------------------------
*.a
Vendor/lib/
Vendor/libTTZipVendor.a
!Vendor/TTZipVendor.xcframework/**/*.a


# ------------------------------------------------------------------------------
# 6. Benchmark Outputs, Test Payloads & Scratch Debris
# ------------------------------------------------------------------------------
docs/benchmarks/*.png
docs/benchmarks/*.svg
docs/benchmarks/*.json
ditto_out.zip
keka_7z.7z
keka_zip.zip
payload/
scratch_bench/
scratch/
reports/
*.bin
*.tbb
test*.7z
test*.zip
test*.tar*
test*.txt
/test_*
!tests/c/**

# ------------------------------------------------------------------------------
# 7. Environment, IDE & Local Overrides
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.user
.vscode/
.idea/

# ------------------------------------------------------------------------------
# 8. Spec Kit & Agent Machine-Local State
# ------------------------------------------------------------------------------
GEMINI.md
.agents/
.specify/
specs/


# ------------------------------------------------------------------------------
# 9. Upstream Drafts, Study & Private Methodology
# ------------------------------------------------------------------------------
docs/upstream/
docs/study/
docs/an_open_letter*.md
scripts/upstream_*
